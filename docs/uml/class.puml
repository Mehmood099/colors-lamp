@startuml class
' COLORS web application - Class Diagram
' The app is not object-oriented, so each source file is modeled as a class
' (its global variables as attributes, its functions as operations), and the
' MySQL tables are modeled as entities using the columns the code references.

title COLORS Web Application - Class Diagram

skinparam classAttributeIconSize 0
skinparam linetype ortho

package "Frontend (public/)" {

  class "index.html" as IndexPage <<page>> {
    - loginName : input[text]
    - loginPassword : input[password]
    - loginButton : button
    - loginResult : span
  }

  class "color.html" as ColorPage <<page>> {
    - userName : span
    - logoutButton : button
    - searchText : input[text]
    - searchColorButton : button
    - colorSearchResult : span
    - colorList : p
    - colorText : input[text]
    - addColorButton : button
    - colorAddResult : span
    --
    + onDOMContentLoaded() : calls readCookie()
  }

  class "code.js" as CodeJS <<script>> {
    + urlBase : String = "http://COP4331-5.com/LAMPAPI"
    + extension : String = "php"
    + userId : int = 0
    + firstName : String = ""
    + lastName : String = ""
    --
    + doLogin() : void
    + saveCookie() : void
    + readCookie() : void
    + doLogout() : void
    + addColor() : void
    + searchColor() : void
  }

  class "md5.js" as MD5JS <<script>> {
    + md5(string) : String
  }
}

package "Backend API (api/)" {

  class "Login.php" as LoginAPI <<endpoint>> {
    - inData : array
    - id : int
    - firstName : String
    - lastName : String
    --
    - getRequestInfo() : array
    - sendResultInfoAsJson(obj) : void
    - returnWithError(err) : void
    - returnWithInfo(firstName, lastName, id) : void
  }

  class "AddColor.php" as AddColorAPI <<endpoint>> {
    - inData : array
    - color : String
    - userId : int
    --
    - getRequestInfo() : array
    - sendResultInfoAsJson(obj) : void
    - returnWithError(err) : void
  }

  class "SearchColors.php" as SearchColorsAPI <<endpoint>> {
    - inData : array
    - searchResults : String
    - searchCount : int
    --
    - getRequestInfo() : array
    - sendResultInfoAsJson(obj) : void
    - returnWithError(err) : void
    - returnWithInfo(searchResults) : void
  }
}

package "Database (MySQL: COP4331)" {

  entity "Users" as Users <<table>> {
    * ID : int <<PK>>
    --
    firstName : varchar
    lastName : varchar
    Login : varchar
    Password : varchar
  }

  entity "Colors" as Colors <<table>> {
    UserID : int <<FK>>
    Name : varchar
  }
}

' page -> script dependencies (<script src=...>)
IndexPage ..> CodeJS : <<include>>
IndexPage ..> MD5JS : <<include>>
ColorPage ..> CodeJS : <<include>>

' script manipulates the page DOM elements
CodeJS --> IndexPage : reads/writes DOM\n(doLogin)
CodeJS --> ColorPage : reads/writes DOM\n(readCookie, addColor,\nsearchColor, doLogout)

' AJAX calls (XMLHttpRequest, POST JSON)
CodeJS ..> LoginAPI : POST {login, password}
CodeJS ..> AddColorAPI : POST {color, userId}
CodeJS ..> SearchColorsAPI : POST {search, userId}

' SQL access
LoginAPI ..> Users : SELECT
AddColorAPI ..> Colors : INSERT
SearchColorsAPI ..> Colors : SELECT ... LIKE

' table relationship
Users "1" -- "0..*" Colors : owns >

note bottom of MD5JS
  Loaded by index.html, but the md5() hashing
  call in doLogin() is commented out, so the
  password is currently sent in plain text.
end note

@enduml
