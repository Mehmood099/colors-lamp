{
  "name": "colors-lamp",
  "version": "1.0.0",
  "private": true,
  "description": "Linting tooling for the Colors LAMP web app (Node.js is used only for linting).",
  "scripts": {
    "lint:html": "htmlhint \"public/**/*.html\"",
    "lint:css": "stylelint \"public/**/*.css\"",
    "lint:js": "eslint \"public/js/**/*.js\"",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "htmlhint": "^1.7.1",
    "stylelint": "^16.25.0",
    "stylelint-config-standard": "^39.0.1"
  }
}
